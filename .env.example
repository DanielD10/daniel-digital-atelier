# Copy this file to .env.local for local dev.
# In production, set the same keys in Vercel → Settings → Environment Variables.
# Never commit .env.local or real keys.

# Canonical origin. Used for metadata, sitemap, robots and OG image URLs.
# Local:      http://localhost:3000
# Preview:    leave unset — Vercel's VERCEL_URL is used automatically
# Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form delivery (optional) ────────────────────────────────
# Without these, the contact API validates and logs the message but
# does not email it. The form still returns success so the UI is
# testable. Add these when you're ready for real delivery.
#
# Get a key at https://resend.com → API Keys
RESEND_API_KEY=
# The address Resend sends from. Must be on a domain you verified in Resend.
CONTACT_FROM_EMAIL=portfolio@yourdomain.com
# Where enquiries land.
CONTACT_TO_EMAIL=danielduran1024@gmail.com
